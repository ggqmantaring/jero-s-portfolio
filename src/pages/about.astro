---
// The About page: the pitch, then skills, tools, education and recognition with room to breathe.
// All content comes from src/data/about.ts.
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import HeroBackground from '../components/HeroBackground.astro';
import Contact from '../components/Contact.astro';
import { about } from '../data/about';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const toolCount = about.tools.reduce((n, t) => n + t.items.length, 0);
---

<Base title="About — Jero Mantaring" description={about.pitch}>
  <header class="head">
    <HeroBackground variant="page" />
    <div class="wrap">
      <SiteNav current="about" />

      <div class="head-body">
        <nav class="label crumbs" aria-label="Breadcrumb">
          <a href={`${base}/`}>Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="here">About</span>
        </nav>

        <div class="head-grid">
          <div>
            <h1>About Jero<span class="block" aria-hidden="true"></span></h1>
            <p class="lede">{about.pitch}</p>
            <a class="btn" href="#contact">&gt; let's work together</a>
          </div>
          <figure class="portrait">
            <img
              src={`${base}/images/gerardo-portrait.jpg`}
              alt="Illustrated self-portrait of Jero in a yellow jacket and red plaid shirt, wearing earphones"
              width="799"
              height="599"
            />
          </figure>
        </div>
      </div>
    </div>
  </header>

  <main class="body">
    <!-- Skills -->
    <section class="part" aria-labelledby="skills-h">
      <div class="part-head">
        <p class="label">01</p>
        <h2 id="skills-h">Skills</h2>
        <p class="part-note">{about.skills.length} areas</p>
      </div>
      <ul class="skills">
        {about.skills.map((s, i) => (
          <li>
            <span class="label skill-num">{pad(i + 1)}</span>
            <h3>{s.name}</h3>
            <p>{s.detail}</p>
            {s.since && <p class="since label">Since {s.since}</p>}
          </li>
        ))}
      </ul>
    </section>

    <!-- Tools -->
    <section class="part" aria-labelledby="tools-h">
      <div class="part-head">
        <p class="label">02</p>
        <h2 id="tools-h">Tools</h2>
        <p class="part-note">{toolCount} tools</p>
      </div>
      <div class="tools">
        {about.tools.map((t) => (
          <div class="tool-row">
            <h3 class="label">{t.group}</h3>
            <ul class="chips">
              {t.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="part" aria-labelledby="edu-h">
      <div class="part-head">
        <p class="label">03</p>
        <h2 id="edu-h">Education</h2>
      </div>
      <ul class="rows">
        {about.education.map((e) => (
          <li>
            <h3>{e.title}</h3>
            <p>{e.where}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Recognition -->
    {about.recognition.length > 0 && (
      <section class="part" aria-labelledby="rec-h">
        <div class="part-head">
          <p class="label">04</p>
          <h2 id="rec-h">Recognition</h2>
        </div>
        <ul class="rows">
          {about.recognition.map((r) => (
            <li>
              <h3>
                <svg class="trophy" viewBox="0 0 9 9" width="16" height="16" aria-hidden="true" shape-rendering="crispEdges">
                  <path d="M1 0h7v1h1v2h-1v1h-1v1h-2v2h2v2h-6v-2h2v-2h-2v-1h-1v-1h-1v-2h1z" />
                </svg>
                {r.title}
              </h3>
              <p>{r.where}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <Contact />
</Base>

<style>
  /* ---------- dark header (matches project pages) ---------- */
  .head {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-ink);
    padding: 28px var(--gutter) clamp(56px, 7vw, 96px);
  }

  .head-body {
    margin-top: clamp(56px, 9vw, 112px);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--on-ink-muted);
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--peach);
  }

  .crumbs .here {
    color: var(--on-ink);
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
    margin-top: 24px;
  }

  h1 {
    font-size: clamp(56px, 9vw, 140px);
    line-height: 0.92;
    letter-spacing: -0.01em;
  }

  .block {
    display: inline-block;
    width: 0.32em;
    height: 0.42em;
    margin-left: 0.08em;
    background: var(--amber);
  }

  .lede {
    margin-top: 28px;
    max-width: 52ch;
    font-size: clamp(15px, 1.4vw, 18px);
  }

  .btn {
    display: inline-block;
    margin-top: 32px;
    padding: 12px 22px;
    border: 1px solid var(--amber);
    background: var(--amber);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .btn:hover {
    background: var(--ink);
    color: var(--amber);
  }

  .portrait {
    margin: 0;
    border: 1px solid var(--on-ink-line);
  }

  /* ---------- body: one part per topic, label column + content ---------- */
  .body {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 96px) var(--gutter) clamp(140px, 16vw, 200px);
  }

  .part {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(24px, 4vw, 64px);
    padding: clamp(40px, 5vw, 64px) 0;
    border-top: 1px solid var(--on-cream-line);
  }

  .part:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .part-head .label {
    color: var(--on-cream-muted);
  }

  .part-head h2 {
    margin-top: 10px;
    font-size: clamp(32px, 4vw, 52px);
  }

  .part-note {
    margin-top: 10px;
    font-size: 13px;
    color: var(--on-cream-muted);
  }

  h3 {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }

  /* skills: roomy cards, three across */
  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .skills li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 20px;
    background: var(--cream-2);
    border-top: 2px solid var(--on-cream);
  }

  .skill-num {
    color: var(--amber);
  }

  .skills p {
    font-size: 14px;
    color: var(--on-cream-muted);
  }

  .skills .since {
    margin-top: auto;
    padding-top: 8px;
    color: var(--navy);
  }

  /* tools: one row per group */
  .tool-row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--on-cream-line);
  }

  .tool-row:first-child {
    padding-top: 4px;
  }

  .tool-row .label {
    color: var(--on-cream-muted);
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    padding: 6px 14px;
    font-size: 14px;
    border: 1px solid var(--on-cream-line);
    background: var(--cream-2);
  }

  /* education & recognition: simple rows */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--on-cream-line);
  }

  .rows li:first-child {
    padding-top: 4px;
  }

  .rows p {
    font-size: 14px;
    color: var(--on-cream-muted);
  }

  .rows h3 {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .trophy {
    flex: none;
    fill: var(--amber);
  }

  @media (max-width: 960px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .head-grid,
    .part {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 420px;
    }
  }

  @media (max-width: 560px) {
    .skills {
      grid-template-columns: 1fr;
    }

    .tool-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
