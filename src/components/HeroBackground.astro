---
// Background layer for the dark hero (home) and the dark project header.
// Its look is set in src/data/settings.ts (hero.background): glow, image, or solid.
import { hero } from '../data/settings';

interface Props {
  /** 'home' = the tall home hero; 'page' = the shorter project header (softer glow). */
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const bg = hero.background;
const style = variant === 'page' && !bg.applyToProjectPages ? 'glow' : bg.style;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { warm, cool, deep, intensity, blur, angle } = bg.glow;

// mix a settings color with transparency, e.g. a(warm, 55) → 55% warm
const a = (c: string, pct: number) => `color-mix(in srgb, ${c} ${pct}%, transparent)`;

const glowLayers =
  variant === 'home'
    ? [
        `radial-gradient(38% 18% at 78% 62%, ${a(warm, 55)}, transparent 70%)`,
        `radial-gradient(30% 14% at 30% 74%, ${a(warm, 28)}, transparent 70%)`,
        `radial-gradient(46% 22% at 52% 52%, ${a(cool, 55)}, transparent 72%)`,
        `radial-gradient(60% 30% at 12% 70%, ${a(deep, 60)}, transparent 70%)`,
      ]
    : [
        `radial-gradient(40% 30% at 82% 70%, ${a(warm, 32)}, transparent 70%)`,
        `radial-gradient(50% 35% at 45% 80%, ${a(cool, 45)}, transparent 72%)`,
      ];
const glowStyle = [
  `background: ${[...glowLayers, 'linear-gradient(180deg, var(--ink) 0%, var(--ink-2) 55%, var(--ink) 100%)'].join(', ')}`,
  `filter: blur(${blur}px)`,
  `transform: rotate(${variant === 'home' ? angle : 0}deg) scale(${variant === 'home' ? 1.25 : 1.2})`,
  // the project header's softer glow runs at full strength when intensity is at its default 0.9
  `opacity: ${variant === 'home' ? intensity : Math.min(1, intensity / 0.9)}`,
].join('; ');
---

{style === 'glow' && <div class="bg" style={glowStyle} aria-hidden="true"></div>}

{style === 'image' && (
  <div class="bg" aria-hidden="true">
    <img
      src={`${base}/${bg.image.src}`}
      alt=""
      style={`object-position: ${bg.image.position}`}
      decoding="async"
      fetchpriority="high"
    />
    <div class="darken" style={`opacity: ${bg.image.darken}`}></div>
  </div>
)}

<style>
  .bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .darken {
    position: absolute;
    inset: 0;
    background: var(--ink);
  }
</style>
