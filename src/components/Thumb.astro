---
import type { Project } from '../data/work';

// Placeholder thumbnail. Swap the .art block for an <img> once real images exist.
interface Props {
  project: Project;
  art: 'pixel' | 'game' | 'video' | 'illustration';
  href: string;
  index: number;
}

const { project, art, href, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<li class="thumb">
  <a href={href}>
    {project.thumb ? (
      <div class:list={['art', `art-${art}`, 'has-img']}>
        <img
          src={`${base}/${project.thumb}`}
          alt={project.alt ?? ''}
          style={project.thumbPosition && `object-position: ${project.thumbPosition}`}
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
    <div class:list={['art', `art-${art}`]} style={`--i: ${index}`} aria-hidden="true">
      {art === 'game' && <span class="press">press start</span>}
      {art === 'video' && (
        <>
          <span class="play"></span>
          <span class="timecode">00:00:00:00</span>
        </>
      )}
      <span class="ph label">placeholder</span>
    </div>
    )}
    <h3 class="title">{project.title}</h3>
    <p class="tag">{project.tag}{project.year && <span class="year"> · {project.year}</span>}</p>
  </a>
</li>

<style>
  .thumb a {
    display: block;
    text-decoration: none;
  }

  .art {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    border: 1px solid var(--on-cream-line);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .thumb a:hover .art {
    transform: translateY(-4px);
  }

  /* real thumbnails: keep the category's shape, crop to fill */
  .has-img {
    background: var(--cream-2);
  }

  .has-img::after {
    display: none;
  }

  .has-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* keep pixel art crisp when scaled up */
  .art-pixel.has-img img {
    image-rendering: pixelated;
  }

  .ph {
    position: absolute;
    top: 10px;
    left: 12px;
    font-size: 10px;
    opacity: 0.7;
  }

  /* pixel art: 1:1 dither checker */
  .art-pixel {
    aspect-ratio: 1;
    background:
      repeating-conic-gradient(rgba(31, 42, 120, 0.14) 0 25%, transparent 0 50%) 0 0 / 12px 12px,
      linear-gradient(calc(135deg + var(--i) * 40deg), var(--cream-2), #d9cdb4);
    color: var(--navy);
  }

  .art-pixel::after {
    content: '';
    width: 22%;
    aspect-ratio: 1;
    background: var(--navy);
    box-shadow:
      calc(var(--i) * 18px + 12px) calc(-12px - var(--i) * 8px) 0 -2px var(--amber),
      -24px calc(24px - var(--i) * 20px) 0 -6px var(--peach);
    transform: translate(calc((var(--i) - 1) * 16px), calc((1 - var(--i)) * 10px));
  }

  /* games: 4:3 CRT screen */
  .art-game {
    aspect-ratio: 4 / 3;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.28) 0 2px, transparent 2px 4px),
      radial-gradient(70% 60% at 50% 45%, var(--ink-2), var(--ink));
    color: var(--on-ink);
  }

  .press {
    font-family: var(--font-pixel);
    font-size: 24px;
    color: var(--peach);
  }

  @media (prefers-reduced-motion: no-preference) {
    .thumb a:hover .press {
      animation: blink 0.9s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* video: 16:9 frame with timecode */
  .art-video {
    aspect-ratio: 16 / 9;
    background: linear-gradient(calc(160deg + var(--i) * 25deg), #1a1d33, var(--ink) 70%);
    color: var(--on-ink);
  }

  .play {
    width: 0;
    height: 0;
    border-left: 22px solid var(--on-ink);
    border-top: 14px solid transparent;
    border-bottom: 14px solid transparent;
    margin-left: 6px;
    opacity: 0.85;
  }

  .timecode {
    position: absolute;
    bottom: 10px;
    left: 12px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--on-ink-muted);
  }

  /* illustration: 4:5 soft color study */
  .art-illustration {
    aspect-ratio: 4 / 5;
    background:
      radial-gradient(60% 40% at calc(30% + var(--i) * 15%) 70%, rgba(242, 191, 147, 0.9), transparent 70%),
      radial-gradient(70% 50% at 70% 25%, rgba(31, 42, 120, 0.75), transparent 70%),
      var(--cream-2);
    color: var(--on-cream);
  }

  .title {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }

  .thumb a:hover .title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .tag {
    margin-top: 2px;
    font-size: 13px;
    color: var(--on-cream-muted);
  }
</style>
