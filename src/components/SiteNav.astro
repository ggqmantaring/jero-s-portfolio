---
// Top bar on dark backgrounds: wordmark + primary links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="top" aria-label="Primary">
  <a class="wordmark" href={`${base}/`}>
    <span class="wordmark-name">Gerardo Mantaring<span class="block" aria-hidden="true"></span></span>
    <span class="label wordmark-sub">Words · Pixels · Games</span>
  </a>
  <ul class="top-links">
    <li><a href={`${base}/#work`} class="is-current">&gt; work</a></li>
    <li><a href={`${base}/#about`}>about</a></li>
    <li><a href="#contact">contact</a></li>
  </ul>
</nav>

<style>
  .top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .wordmark {
    text-decoration: none;
    display: grid;
    gap: 4px;
  }

  .wordmark-name {
    font-family: var(--font-pixel);
    font-size: 22px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .wordmark-sub {
    color: var(--on-ink-muted);
  }

  .block {
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.3em;
    vertical-align: 0.1em;
    background: var(--amber);
  }

  .top-links {
    display: flex;
    gap: clamp(16px, 3vw, 40px);
    list-style: none;
    margin: 0;
    padding: 4px 0 0;
  }

  .top-links a {
    text-decoration: none;
    color: var(--on-ink);
  }

  .top-links a:hover {
    color: var(--peach);
  }

  .top-links .is-current {
    color: var(--amber);
  }

  @media (max-width: 560px) {
    .top {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
