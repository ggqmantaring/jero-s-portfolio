---
import { categories } from '../data/work';
import { hero } from '../data/settings';
import SiteNav from './SiteNav.astro';
import HeroBackground from './HeroBackground.astro';

// counted from src/data/work.ts at build time, so these follow the project list
const totalProjects = categories.reduce((n, c) => n + c.projects.filter((p) => !p.placeholder).length, 0);
const pad = (n: number) => String(n).padStart(2, '0');
const { headline, intro, primaryButton, secondaryButton, stats, spacing } = hero;
const spacingVars = `--space-top: ${spacing.aboveHeadline}px; --space-bottom: ${spacing.belowContent}px`;
---

<header class="hero" style={spacingVars}>
  <HeroBackground variant="home" />

  <div class="wrap">
  <SiteNav />

  <div class:list={['hero-body', { 'no-stats': !stats.show }]}>
    <div class="hero-copy">
      <h1>{headline}<span class="block" aria-hidden="true"></span></h1>
      {intro && <p class="lede">{intro}</p>}
      {(primaryButton.show || secondaryButton.show) && (
        <div class="actions">
          {primaryButton.show && <a class="btn" href={primaryButton.href}>&gt; {primaryButton.label}</a>}
          {secondaryButton.show && (
            <a class="ghost" href={secondaryButton.href}>{secondaryButton.label} <span aria-hidden="true">▸</span></a>
          )}
        </div>
      )}
    </div>

    {stats.show && (
      <dl class="status">
        <div>
          <dt class="label">{stats.projectsLabel}</dt>
          <dd class="big">{pad(totalProjects)}<span class="unit">projects</span></dd>
        </div>
        <div>
          <dt class="label">{stats.fieldsLabel}</dt>
          <dd>{pad(categories.length)} fields</dd>
        </div>
        {stats.status && (
          <div>
            <dt class="label">{stats.statusLabel}</dt>
            <dd class="open">{stats.pulse && <span class="pulse" aria-hidden="true"></span>}{stats.status}</dd>
          </div>
        )}
      </dl>
    )}
  </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-ink);
    /* below-content spacing comes from settings: about half on phones, full on wide screens */
    padding: 28px var(--gutter) clamp(calc(var(--space-bottom) * 0.53), 9vw, var(--space-bottom));
  }

  .block {
    display: inline-block;
    width: 0.32em;
    height: 0.42em;
    margin-left: 0.08em;
    background: var(--amber);
  }

  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: end;
    margin-top: clamp(calc(var(--space-top) * 0.48), 12vw, var(--space-top));
  }

  .hero-body.no-stats {
    grid-template-columns: minmax(0, 1fr);
  }

  h1 {
    font-size: clamp(48px, 9.4vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.01em;
    max-width: 11ch;
  }

  .lede {
    margin-top: 28px;
    max-width: 46ch;
    font-size: clamp(15px, 1.4vw, 18px);
    color: var(--on-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
    margin-top: 36px;
  }

  .btn {
    display: inline-block;
    padding: 12px 22px;
    border: 1px solid var(--amber);
    background: var(--amber);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    transition: background-color 160ms ease, color 160ms ease;
  }

  /* hover: the hero's darkest ink */
  .btn:hover {
    background: var(--ink);
    color: var(--amber);
  }

  .ghost {
    text-decoration: none;
  }

  .ghost span {
    color: var(--amber);
  }

  .ghost:hover {
    color: var(--peach);
  }

  .status {
    display: grid;
    gap: 28px;
    margin: 0;
    min-width: 220px;
  }

  .status dt {
    color: var(--on-ink-muted);
  }

  .status dd {
    margin: 4px 0 0;
  }

  .status .big {
    font-family: var(--font-pixel);
    font-size: 72px;
    line-height: 1;
  }

  .unit {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--on-ink-muted);
  }

  .open {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pulse {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--amber);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--amber);
      animation: ping 2s ease-out infinite;
    }
  }

  @keyframes ping {
    0% { transform: scale(1); opacity: 0.7; }
    80%, 100% { transform: scale(3); opacity: 0; }
  }

  @media (max-width: 860px) {
    .hero-body {
      grid-template-columns: 1fr;
    }

    .status {
      grid-template-columns: repeat(2, auto);
      justify-content: start;
      gap: 24px 40px;
      padding-top: 24px;
      border-top: 1px solid var(--on-ink-line);
    }

    .status > :last-child {
      grid-column: 1 / -1;
    }

    .status .big {
      font-size: 44px;
    }
  }
</style>
