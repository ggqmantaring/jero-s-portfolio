---
import { rowSize, type Category } from '../data/work';
import ProjectGrid from './ProjectGrid.astro';

interface Props {
  category: Category;
  number: string;
  /** Category pages show every project instead of the home-page preview. */
  all?: boolean;
}

const { category, number, all = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// the home page shows one row: 3 projects, or 2 for categories with bigger thumbnails
const shown = rowSize(category);
const preview = all ? category.projects : category.projects.slice(0, shown);
const hasMore = !all && category.projects.length > shown;
---

<section class="work" id={category.slug} data-section aria-labelledby={`${category.slug}-label`}>
  <p class="label eyebrow" id={`${category.slug}-label`}>{number} — {category.name}</p>
  <h2>{category.heading}</h2>
  <p class="intro">{category.intro}</p>

  <ProjectGrid category={category} projects={preview} />

  {hasMore && (
    <a class="more btn-outline" href={`${base}/${category.slug}`}>
      See all {category.short} ({category.projects.length}) <span aria-hidden="true">→</span>
    </a>
  )}
</section>

<style>
  .work {
    padding: clamp(56px, 8vw, 96px) 0;
    border-top: 1px solid var(--on-cream-line);
    scroll-margin-top: 24px;
  }

  .work:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .eyebrow {
    color: var(--on-cream-muted);
  }

  h2 {
    margin-top: 20px;
    font-size: clamp(28px, 3.6vw, 44px);
    max-width: 20ch;
  }

  .intro {
    margin-top: 16px;
    max-width: 58ch;
    color: var(--on-cream-muted);
  }

  .more {
    margin-top: 36px;
  }

  @media (max-width: 900px) {
    .work {
      scroll-margin-top: calc(var(--mobile-bar-h) + 16px);
    }
  }
</style>
